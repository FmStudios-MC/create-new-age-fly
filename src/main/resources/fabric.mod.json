{
  "schemaVersion": 1,
  "id": "create_new_age",
  "version": "${version}",
  "name": "Create: New Age (Fly Port)",
  "description": "Unofficial Fabric / Minecraft 26.2 port of Create: New Age by Antarctic Gardens, an addon for the Create mod that adds integration with electricity. Built on ZurrTum's Create Fly. Not made, maintained or supported by Antarctic Gardens; all rights to Create: New Age belong to them.",
  "authors": [
    "Antarctic Gardens"
  ],
  "contributors": [
    "FabiMvurice Interactive (Fabric / 26.2 port)",
    "ZurrTum (Create Fly)"
  ],
  "contact": {
    "homepage": "https://github.com/FmStudios-MC/create-new-age-fly",
    "sources": "https://github.com/FmStudios-MC/create-new-age-fly",
    "issues": "https://github.com/FmStudios-MC/create-new-age-fly/issues"
  },
  "license": "BSD-3-Clause",
  "icon": "assets/create_new_age/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.antarcticgardens.cna.CreateNewAge"
    ],
    "client": [
      "org.antarcticgardens.cna.CreateNewAgeClient"
    ],
    "jei_mod_plugin": [
      "org.antarcticgardens.cna.client.compat.jei.CNAJeiPlugin"
    ]
  },
  "accessWidener": "create_new_age.classtweaker",
  "mixins": [
    "create_new_age.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=26.2- <26.3-",
    "java": ">=25",
    "fabric-api": "*",
    "create": "${create_fly_version_range}"
  },
  "suggests": {
    "computercraft": "*"
  }
}
